{
  "expo": {
    "name": "Hawk",
    "slug": "hawk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/logo.png",
    "scheme": "hawk",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D12",
    "ios": {
      "icon": "./assets/logo/logo.png",
      "bundleIdentifier": "com.musfir.thahir.Hawk",
      "infoPlist": {
        "NSFaceIDUsageDescription": "This app uses Face ID to securely log you into your account.",
        "NSPhotoLibraryUsageDescription": "Hawk needs access to your photo library to let you select a profile picture.",
        "NSCameraUsageDescription": "Hawk needs access to your camera to let you take a profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0D12",
        "foregroundImage": "./assets/logo/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.musfir.thahir.Hawk",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo/logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D12",
          "image": "./assets/logo/logo-removebg-preview.png",
          "imageWidth": 100
        }
      ],
      "expo-sqlite",
      "@react-native-google-signin/google-signin",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Hawk to use Face ID for biometric authentication."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hawk needs access to your photo library to let you select a profile picture.",
          "cameraPermission": "Hawk needs access to your camera to let you take a profile picture."
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "hidden": false,
          "enforceContrast": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "light",
        "hidden": false
      },
      "eas": {
        "projectId": "63d267fc-aaf1-46ca-90e1-c4c00dadbc44"
      }
    },
    "owner": "musfir.thahir"
  }
}
